    }
   },
   "kind": "type"
  },
  "Orders.anonymous.type2": {
   "elements": {
    "previousItemAmount": {
     "@description": "The amount for the item before the value of the current discount is applied.",
     "type": "cds.Double",
     "@Core.Example.$Type": "Core.PrimitiveExampleValue",
     "@Core.Example.Value": 11.22
    },
    "newItemAmount": {
     "@description": "The amount for the item after the value of the current discount is applied.",
     "type": "cds.Double",
     "@Core.Example.$Type": "Core.PrimitiveExampleValue",
     "@Core.Example.Value": 11.22
    }
   },
   "includes": [
    "Orders_types.BaseDiscountLine"
   ],
   "kind": "type"
  },
