     "type": "cds.String",
     "length": 255
    },
    "salutationCode": {
     "@description": "The code of the salutation for the person.",
     "type": "cds.String",
     "length": 255
    },
    "name": {
     "@description": "The person's full name.",
     "type": "cds.String"
    }
   },
   "kind": "type"
  },
  "Orders_types.Quantity": {
